DEEPSEEK_API_KEY=
LIT_MODEL=deepseek-flash
LIT_BASE_URL=https://api.deepseek.com
LIT_PORT=7860
LIT_TASK_SECONDS=180
# Reading tasks include extraction, final notes, and citation review.
LIT_READING_SECONDS=600
LIT_READING_MAX_TOKENS=8192
# Absolute paths may be used for independent demo/test instances.
# LIT_DB_PATH=D:/shixi/agent/lit_agent.db
# LIT_DATA_DIR=D:/shixi/agent/data
# Keep off until you explicitly download the embedding model.
LIT_ALLOW_MODEL_DOWNLOAD=0
